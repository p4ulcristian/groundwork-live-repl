;; groundwork-live-repl: groundwork's REPL. An nREPL server by settings (:development,
;; :ssh-only, or :off with an emergency switch), every evaluation written to
;; the app's log, the app's own tools in groundwork-live-repl.tools. One tree:
;; source-code/groundwork_live_repl/.
{:paths ["source-code"]

 :deps
 {;; the REPL server, and the client the tests talk to it with
  nrepl/nrepl   {:mvn/version "1.8.0"}
  ;; the settings and options, checked before anything opens
  metosin/malli {:mvn/version "0.20.3"}}

 :aliases
 {;; the tests:  clojure -X:test
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; the app's log in the tests is a real one, written as JSON
                       io.github.p4ulcristian/groundwork-logs       {:git/tag "v0.1.2" :git/sha "823f8fc"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}}}
